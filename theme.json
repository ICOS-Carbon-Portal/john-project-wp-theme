{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "800px",
      "wideSize": "1200px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "primary",
          "color": "#005E61",
          "name": "Teal"
        },
        {
          "slug": "primary-dark",
          "color": "#00363A",
          "name": "Dark teal"
        },
        {
          "slug": "info",
          "color": "#00ABC9",
          "name": "Cyan (logo)"
        },
        {
          "slug": "info-light",
          "color": "#B2E6EF",
          "name": "Light cyan"
        },
        {
          "slug": "tint",
          "color": "#F0F8F9",
          "name": "Pale cyan"
        },
        {
          "slug": "tint-2",
          "color": "#DCEFF2",
          "name": "Pale cyan 2"
        },
        {
          "slug": "border",
          "color": "#D5E2E4",
          "name": "Border"
        },
        {
          "slug": "accent",
          "color": "#AEC000",
          "name": "Green (logo)"
        },
        {
          "slug": "accent-light",
          "color": "#F8FAE4",
          "name": "Pale green"
        },
        {
          "slug": "accent-2",
          "color": "#ABBEEF",
          "name": "Blue (logo)"
        },
        {
          "slug": "accent-3",
          "color": "#FFA183",
          "name": "Salmon"
        },
        {
          "slug": "link-blue",
          "color": "#092E95",
          "name": "Link blue"
        },
        {
          "slug": "dark",
          "color": "#414141",
          "name": "Text"
        },
        {
          "slug": "secondary",
          "color": "#656567",
          "name": "Gray"
        },
        {
          "slug": "white",
          "color": "#FFFFFF",
          "name": "White"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": false,
      "fontFamilies": [
        {
          "slug": "body",
          "name": "Open Sans",
          "fontFamily": "\"Open Sans\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Open Sans",
              "fontStyle": "normal",
              "fontWeight": "300 800",
              "fontStretch": "75% 100%",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/open-sans.woff2"
              ]
            },
            {
              "fontFamily": "Open Sans",
              "fontStyle": "italic",
              "fontWeight": "300 800",
              "fontStretch": "75% 100%",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/open-sans-italic.woff2"
              ]
            }
          ]
        },
        {
          "slug": "heading",
          "name": "Open Sans Condensed",
          "fontFamily": "\"Open Sans Condensed\", \"Open Sans\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Open Sans Condensed",
              "fontStyle": "normal",
              "fontWeight": "300 800",
              "fontStretch": "75%",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/open-sans.woff2"
              ]
            },
            {
              "fontFamily": "Open Sans Condensed",
              "fontStyle": "italic",
              "fontWeight": "300 800",
              "fontStretch": "75%",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/open-sans-italic.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "size": "0.875rem",
          "name": "Extra small"
        },
        {
          "slug": "small",
          "size": "1rem",
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "1.125rem",
          "name": "Medium"
        },
        {
          "slug": "large",
          "size": "1.375rem",
          "name": "Large (lead)"
        },
        {
          "slug": "x-large",
          "size": "1.75rem",
          "name": "Extra large"
        },
        {
          "slug": "xx-large",
          "size": "clamp(2rem, 1.5rem + 1.5vw, 2.5rem)",
          "name": "Huge"
        },
        {
          "slug": "display",
          "size": "clamp(2.25rem, 0.5rem + 3.6vw, 3.375rem)",
          "name": "Display"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--dark)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.67"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--dark)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "800",
          "lineHeight": "1.15"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "clamp(2.25rem, 1.75rem + 1.5vw, 3rem)",
          "lineHeight": "1.17"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)",
          "lineHeight": "1.2"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)",
          "lineHeight": "1.15"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)",
          "lineHeight": "1.25"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--link-blue)"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary)"
          }
        }
      },
      "button": {
        "border": {
          "radius": "4px"
        },
        "color": {
          "background": "var(--wp--preset--color--info)",
          "text": "var(--wp--preset--color--primary-dark)"
        },
        "spacing": {
          "padding": {
            "top": "0.45em",
            "bottom": "0.45em",
            "left": "1.2em",
            "right": "1.2em"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontSize": "1.25rem",
          "fontWeight": "400",
          "lineHeight": "1.5"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary)",
            "text": "var(--wp--preset--color--white)"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var(--wp--preset--color--secondary)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-small)"
        }
      }
    },
    "blocks": {
      "core/breadcrumbs": {
        "color": {
          "text": "var(--wp--preset--color--secondary)"
        },
        "typography": {
          "fontSize": "0.9375rem"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--primary)"
            }
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontSize": "1.25rem",
          "fontWeight": "400"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--primary)"
              }
            }
          }
        }
      },
      "core/post-title": {
        "elements": {
          "link": {
            "color": {
              "text": "inherit"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--primary)"
              }
            }
          }
        }
      },
      "core/post-date": {
        "color": {
          "text": "var(--wp--preset--color--secondary)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-small)"
        }
      },
      "core/post-excerpt": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "lineHeight": "1.625"
        }
      },
      "core/read-more": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontSize": "1.25rem",
          "textDecoration": "none"
        }
      },
      "core/quote": {
        "border": {
          "radius": "0",
          "top": {
            "width": "0"
          },
          "right": {
            "width": "0"
          },
          "bottom": {
            "width": "0"
          },
          "left": {
            "color": "var(--wp--preset--color--info)",
            "style": "solid",
            "width": "4px"
          }
        },
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        "spacing": {
          "padding": {
            "top": "0.25rem",
            "right": "0",
            "bottom": "0.25rem",
            "left": "1.75rem"
          },
          "margin": {
            "left": "0",
            "right": "0"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontSize": "var(--wp--preset--font-size--x-large)",
          "fontStyle": "normal",
          "fontWeight": "400",
          "lineHeight": "1.25"
        },
        "elements": {
          "cite": {
            "color": {
              "text": "var(--wp--preset--color--secondary)"
            },
            "typography": {
              "fontFamily": "var(--wp--preset--font-family--body)",
              "fontSize": "var(--wp--preset--font-size--x-small)",
              "fontStyle": "normal"
            }
          }
        }
      },
      "core/button": {
        "variations": {
          "outline": {
            "border": {
              "color": "var(--wp--preset--color--info)",
              "width": "2px",
              "style": "solid"
            },
            "color": {
              "background": "transparent",
              "text": "var(--wp--preset--color--primary)"
            },
            "spacing": {
              "padding": {
                "top": "calc(0.45em - 2px)",
                "bottom": "calc(0.45em - 2px)",
                "left": "calc(1.2em - 2px)",
                "right": "calc(1.2em - 2px)"
              }
            }
          }
        }
      },
      "core/image": {
        "border": {
          "radius": "4px"
        }
      },
      "core/post-featured-image": {
        "border": {
          "radius": "4px"
        }
      }
    }
  },
  "templateParts": [
    {
      "area": "header",
      "name": "header",
      "title": "Header"
    },
    {
      "area": "footer",
      "name": "footer",
      "title": "Footer"
    },
    {
      "area": "uncategorized",
      "name": "related-news",
      "title": "Related news"
    }
  ]
}
